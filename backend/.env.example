# Database (docker-compose overrides this automatically)
DATABASE_URL=postgresql://johnycutz:johnycutz@localhost:5432/johnycutz

# Frontend origin allowed by CORS (production URL)
FRONTEND_URL=https://johnycutz.pt
SITE_URL=https://johnycutz.pt

# Google Calendar (service account JSON mounted at /app/credentials.json)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=/app/credentials.json

# SMTP (e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
BARBER_EMAIL=johnycutz@gmail.com

# Working hours (Atlantic/Azores timezone)
WORK_START=09:00
WORK_END=19:00
# Closed days, 0=Monday .. 6=Sunday (comma-separated)
CLOSED_WEEKDAYS=6
